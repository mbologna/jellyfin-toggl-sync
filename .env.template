# Jellyfin API Configuration
# Requires the "Playback Reporting" plugin installed on your Jellyfin server:
# https://github.com/jellyfin/jellyfin-plugin-playbackreporting
JELLYFIN_URL=https://jellyfin.example.com
# Create an API key: Jellyfin Dashboard -> Advanced -> API Keys
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# Optional: only sync plays from this Jellyfin user (dashed or dashless GUID).
# Leave blank to sync plays from all users on the server.
JELLYFIN_USER_ID=

# How many hours of playback history to check per run (default: 24)
JELLYFIN_HISTORY_HOURS=24

# Minimum play duration (actual watched minutes) to sync (default: 10)
JELLYFIN_MIN_DURATION_MINUTES=10

# Toggl API Configuration
# Get API token from https://track.toggl.com/profile
TOGGL_API_TOKEN=your_toggl_api_token_here

# Find these in your Toggl workspace
TOGGL_WORKSPACE_ID=your_workspace_id
TOGGL_PROJECT_ID=your_project_id

# Optional: Comma-separated tags for entries
TOGGL_TAGS=watching,entertainment

# Optional: Override state file location (useful for Docker)
# SYNC_STATE_FILE=/app/data/.sync_state.json
